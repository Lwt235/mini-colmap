{
  "method": "3dgs",
  "device": "cuda",
  "iterations": 10000,
  "learning_rate": 0.001,
  "image_downscale": 2,
  "holdout_every": 20,
  "seed": 0,
  "preview_every": 500,
  "background": "black",
  "gaussian": {
    "backend": "gsplat",
    "scene_normalization": "camera_extent",
    "initial_scale_mode": "knn",
    "initial_scale": 0.01,
    "initial_opacity": 0.1,
    "max_gaussians": 100000,
    "sh_degree": 3,
    "sh_degree_interval": 1000,
    "optimizer_state": "preserve",
    "lr_mode": "grouped",
    "position_lr_final_ratio": 0.01,
    "loss": "l1_ssim",
    "ssim_weight": 0.2,
    "density_strategy": "adaptive",
    "densify_every": 100,
    "densify_start": 500,
    "densify_stop": 6666,
    "grow_grad2d": 0.0002,
    "split_scale": 0.01,
    "prune_scale": 0.1,
    "prune_screen_radius": 0.15,
    "min_opacity": 0.005,
    "opacity_reset_every": 3000
  }
}
